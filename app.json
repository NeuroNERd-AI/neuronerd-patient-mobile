{
  "expo": {
    "name": "NeuroNERd",
    "slug": "neuronerd-patient-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "neuronerd",
    "ios": { "supportsTablet": true },
    "android": { "package": "ai.neuronerd.patient", "permissions": ["POST_NOTIFICATIONS"] },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store", "expo-font", "expo-notifications"],
    "experiments": { "typedRoutes": true },
    "extra": { "router": { "origin": false } }
  }
}
